# NetHack 5.0 -- "Modern + Mouse" default config for the Windows GUI
# Delete or edit any line to taste. '#' starts a comment.

# ======================= MOUSE =======================
# LEFT click on the map   = walk / travel / open door / attack, automatically
# HOLD left + drag        = character follows the mouse in real time
# RIGHT click on a tile   = dropdown menu of what you can do there
# SCROLL WHEEL            = zoom the map in / out (immersive close-ups)
# (these are the built-in defaults of this build; mouse_support must stay on)
OPTIONS=mouse_support:1
OPTIONS=travel

# ======================= LOOK & FEEL =======================
# Scales the map to the window instead of a fixed pixel size.
# Prefer crisp fixed tiles?  Use map_mode:tiles  (and tile_width/tile_height)
# Scroll-wheel zoom works on top of this.
OPTIONS=map_mode:tiles_fit_to_screen,scroll_margin:8
OPTIONS=!splash_screen

# Pixel-themed UI fonts (crisp, non-antialiased look)
# Consolas / Cascadia Mono / Fixedsys give a clean pixel / terminal feel.
# Install "Press Start 2P" or "Pixel Operator" for an even more retro look
# and set e.g.  font_message:Press Start 2P
OPTIONS=font_message:Consolas,font_size_message:14,align_message:top
OPTIONS=font_menu:Consolas,font_size_menu:14
OPTIONS=font_text:Consolas,font_size_text:14
OPTIONS=font_status:Consolas,font_size_status:14
OPTIONS=font_map:Consolas

# Dark theme for message / status / text / menu windows
OPTIONS=windowcolors:status #E4E6EF/#16181D message #E4E6EF/#16181D text #E4E6EF/#1B1D23 menu #E4E6EF/#1B1D23

# Always-visible inventory panel (set to !perm_invent to hide)
OPTIONS=perm_invent,perminv_mode:all

# Helpful visual feedback while using the mouse
OPTIONS=autodescribe
OPTIONS=hilite_pet,hilite_pile
OPTIONS=lit_corridor,dark_room
OPTIONS=mention_walls
OPTIONS=time,showexp,!toptenwin

# ======================= QUALITY OF LIFE =======================
# number_pad:0 -> keyboard keys are plain (the right-click menu sends e.g. "20s").
# The numeric keypad still moves you.
OPTIONS=number_pad:0
OPTIONS=force_invmenu
OPTIONS=suppress_alert:3.3.1
OPTIONS=autopickup,pickup_types:$
OPTIONS=pickup_thrown
OPTIONS=autoquiver
OPTIONS=runmode:run
OPTIONS=symset:IBMGraphics_2,roguesymset:RogueEpyx
OPTIONS=boulder:0

# Menu colours (blessed/cursed highlighting)
OPTIONS=menucolors
MENUCOLOR=" blessed " = green
MENUCOLOR=" holy " = green
MENUCOLOR=" cursed " = red
MENUCOLOR=" unholy " = red
MENUCOLOR=" cursed .* \(being worn\)" = orange&underline

# Personal preferences (uncomment & edit)
#OPTIONS=name:Janet,role:Valkyrie,race:Human,gender:female,align:lawful
#OPTIONS=dogname:Fido,catname:Morris

