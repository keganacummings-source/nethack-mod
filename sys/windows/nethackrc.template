# NetHack 5.0 -- "Dreamdaw / TURBZ" UI theme for the Windows GUI
# Color palette taken from https://dreamdaw.com (TURBZ)
#   ink bg     #140e0c
#   panel      #241814
#   cream text #f0e2c8
#   dim text   #a89880
#   kyo gold   #e6c15a
#   coral red  #c4473a
#   ui-line    #5a483a

# ======================= MOUSE =======================
# LEFT click on the map   = walk / travel / open door / attack
# HOLD left + drag        = character follows the mouse in real time
# RIGHT click on a tile   = dropdown menu of what you can do there
# SCROLL WHEEL            = zoom the map in / out
OPTIONS=mouse_support:1
OPTIONS=travel

# ======================= LOOK & FEEL (dreamdaw) =======================
OPTIONS=map_mode:tiles_fit_to_screen,scroll_margin:8
OPTIONS=!splash_screen

# Pixel / retro fonts (install free "VT323" or "Press Start 2P" for full match)
# Fallbacks: Consolas, Cascadia Mono, Fixedsys
OPTIONS=font_message:VT323,font_size_message:18,align_message:top
OPTIONS=font_menu:VT323,font_size_menu:16
OPTIONS=font_text:VT323,font_size_text:16
OPTIONS=font_status:VT323,font_size_status:16
OPTIONS=font_map:Consolas

# If VT323 is not installed, uncomment these Consolas lines instead:
#OPTIONS=font_message:Consolas,font_size_message:14,align_message:top
#OPTIONS=font_menu:Consolas,font_size_menu:14
#OPTIONS=font_text:Consolas,font_size_text:14
#OPTIONS=font_status:Consolas,font_size_status:14

# Dreamdaw window colors: cream text on ink / panel backgrounds
# format: windowtype fg/bg
OPTIONS=windowcolors:status #F0E2C8/#140E0C message #F0E2C8/#140E0C text #F0E2C8/#241814 menu #F0E2C8/#241814

# Always-visible inventory panel
OPTIONS=perm_invent,perminv_mode:all

# Visual feedback
OPTIONS=autodescribe
OPTIONS=hilite_pet,hilite_pile
OPTIONS=lit_corridor,dark_room
OPTIONS=mention_walls
OPTIONS=time,showexp,!toptenwin

# ======================= QUALITY OF LIFE =======================
OPTIONS=number_pad:0
OPTIONS=force_invmenu
OPTIONS=suppress_alert:3.3.1
OPTIONS=autopickup,pickup_types:$
OPTIONS=pickup_thrown
OPTIONS=autoquiver
OPTIONS=runmode:run
OPTIONS=symset:IBMGraphics_2,roguesymset:RogueEpyx
OPTIONS=boulder:0

# Menu colours (blessed/cursed) — gold / coral accents
OPTIONS=menucolors
MENUCOLOR=" blessed " = yellow
MENUCOLOR=" holy " = yellow
MENUCOLOR=" cursed " = red
MENUCOLOR=" unholy " = red
MENUCOLOR=" cursed .* \\(being worn\\)" = orange&underline

# Personal preferences (uncomment & edit)
#OPTIONS=name:Janet,role:Valkyrie,race:Human,gender:female,align:lawful
#OPTIONS=dogname:Fido,catname:Morris

# Status hilites — softer on the eyes, gold when healthy
OPTIONS=statushilites
OPTIONS=hitpointbar
OPTIONS=hilite_status:hitpoints/100%/gray&normal
OPTIONS=hilite_status:hitpoints/<100%/green&normal
OPTIONS=hilite_status:hitpoints/<66%/yellow&normal
OPTIONS=hilite_status:hitpoints/<50%/orange&normal
OPTIONS=hilite_status:hitpoints/<33%/red&bold
OPTIONS=hilite_status:hitpoints/<15%/red&inverse

OPTIONS=hilite_status:power/100%/gray&normal
OPTIONS=hilite_status:power/<100%/green&normal
OPTIONS=hilite_status:power/<66%/yellow&normal
OPTIONS=hilite_status:power/<50%/orange&normal
OPTIONS=hilite_status:power/<33%/red&bold

OPTIONS=hilite_status:cap/burdened/yellow/stressed/orange/strained/red&bold/overtaxed/red&inverse/overloaded/red&inverse&blink
OPTIONS=hilite_status:hunger/satiated/yellow/hungry/orange/weak/red&bold/fainting/red&inverse/fainted/red&inverse&blink
OPTIONS=hilite_status:condition/hallu/yellow
OPTIONS=hilite_status:condition/conf/orange
OPTIONS=hilite_status:condition/stun/red&bold
OPTIONS=hilite_status:condition/termill/red&inverse
OPTIONS=hilite_status:condition/foodpois/red&inverse
OPTIONS=hilite_status:condition/slime/red&inverse
OPTIONS=hilite_status:gold/up/yellow/down/brown
OPTIONS=hilite_status:characteristics/up/green/down/red
